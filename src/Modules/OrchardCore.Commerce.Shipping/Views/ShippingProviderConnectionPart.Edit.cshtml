@model ShippingProviderConnectionPartViewModel

<div class="ocat-wrapper" asp-validation-class-for="ConnectionName">
    <label asp-for="ConnectionName" class="ocat-label ocat-label-required">@T["Connection Name"]</label>
    <div class="ocat-end">
        <input asp-for="ConnectionName" class="form-control" />
        <span asp-validation-for="ConnectionName"></span>
        <span class="hint">@T["A friendly name to identify this carrier account (e.g. 'DHL Poland Production')."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="ProviderId">
    <label asp-for="ProviderId" class="ocat-label ocat-label-required">@T["Provider"]</label>
    <div class="ocat-limited">
        <select asp-for="ProviderId" class="form-select">
            <option value="">— @T["Select provider"] —</option>
            @foreach (var pid in Model.AvailableProviderIds)
            {
                <option value="@pid" selected="@(Model.ProviderId == pid ? "selected" : null)">@pid</option>
            }
        </select>
        <span asp-validation-for="ProviderId"></span>
        <span class="hint">@T["The shipping carrier this connection authenticates with."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="CredentialsJson">
    <label asp-for="CredentialsJson" class="ocat-label">@T["Credentials (JSON)"]</label>
    <div class="ocat-end">
        <textarea asp-for="CredentialsJson" class="form-control code" rows="5" placeholder="{&quot;ApiKey&quot;:&quot;…&quot;,&quot;ApiSecret&quot;:&quot;…&quot;,&quot;AccountNumber&quot;:&quot;…&quot;}"></textarea>
        <span asp-validation-for="CredentialsJson"></span>
        <span class="hint">@T["Provider credentials as JSON. Stored encrypted at rest. Required keys depend on the chosen provider."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="IsEnabled" class="form-check-input" type="checkbox" />
            <label asp-for="IsEnabled" class="form-check-label">@T["Enabled"]</label>
        </div>
        <span class="hint">@T["Disable to temporarily stop this connection from being used for rate quotes or shipment creation."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="IsTestMode" class="form-check-input" type="checkbox" />
            <label asp-for="IsTestMode" class="form-check-label">@T["Test / Sandbox Mode"]</label>
        </div>
        <span class="hint">@T["Use the carrier's sandbox environment. Rates and labels will not be real."]</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.LastHealthStatus))
{
    <div class="ocat-wrapper">
        <span class="ocat-label">@T["Last Health Check"]</span>
        <div class="ocat-end">
            @{
                var badge = Model.LastHealthStatus.Contains("Healthy", StringComparison.OrdinalIgnoreCase) ? "bg-success"
                    : Model.LastHealthStatus.Contains("Unhealthy", StringComparison.OrdinalIgnoreCase) ? "bg-danger"
                    : "bg-secondary";
            }
            <span class="badge @badge">@Model.LastHealthStatus</span>
        </div>
    </div>
}
