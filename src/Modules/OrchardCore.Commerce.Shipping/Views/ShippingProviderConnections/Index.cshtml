@model ShippingProviderConnectionListViewModel

<zone Name="Title"><h1>@RenderTitleSegments(T["Shipping Provider Connections"])</h1></zone>

<form asp-action="Index" method="get" class="no-multisubmit">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" name="search" value="@Model.Search" class="form-control" placeholder="@T["Search"]" type="search" autocomplete="off" />
                        <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-secondary create" role="button" data-bs-toggle="modal" data-bs-target="#modalAddConnection">@T["Add Connection"]</button>
                </div>
            </div>
        </div>
    </div>
</form>

@if (Model.Connections.Count == 0)
{
    <div class="alert alert-info my-3" role="alert">
        @T["There are no shipping provider connections at the moment."]
    </div>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var connection in Model.Connections)
        {
            <li class="list-group-item d-flex align-items-center gap-3">
                <div class="flex-grow-1">
                    <a asp-action="Edit" asp-route-id="@connection.Id" class="fw-bold">@connection.Name</a>
                    <div class="small text-muted">
                        @connection.ProviderDisplayName
                        &middot; @(connection.IsTestMode ? T["Test / Sandbox"] : T["Production"])
                    </div>
                </div>
                <div>
                    @if (connection.IsEnabled)
                    {
                        <span class="badge bg-success">@T["Enabled"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@T["Disabled"]</span>
                    }
                </div>
                <div class="d-inline-flex gap-1">
                    <a asp-action="Edit" asp-route-id="@connection.Id" class="btn btn-primary btn-sm">@T["Edit"]</a>
                    <a asp-action="Delete" asp-route-id="@connection.Id" class="btn btn-danger btn-sm" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete connection"]" data-message="@T["Are you sure you want to delete this connection and its stored credentials?"]">@T["Delete"]</a>
                </div>
            </li>
        }
    </ul>
}

<div class="modal fade" id="modalAddConnection" tabindex="-1" role="dialog" aria-labelledby="available-provider-types-title" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="available-provider-types-title">@T["Available Providers"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (Model.Providers.Count == 0)
                {
                    <p class="p-3 mb-2 bg-warning text-white">@T["You need to enable a feature which provides a shipping provider."]</p>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-3 g-2">
                        @foreach (var provider in Model.Providers)
                        {
                            OrchardCore.DisplayManagement.IShape shape = await New.ShippingProviderConnection_Link(
                                ProviderKey: provider.ProviderKey,
                                DisplayName: provider.DisplayName,
                                Description: provider.Description);
                            shape.Metadata.Alternates.Add("ShippingProviderConnection_Link__" + provider.ProviderKey);

                            @await DisplayAsync(shape)
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
            </div>
        </div>
    </div>
</div>
