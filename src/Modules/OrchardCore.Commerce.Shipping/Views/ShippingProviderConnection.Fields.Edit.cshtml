@model ShippingProviderConnectionViewModel

<div class="ocat-wrapper">
    <span class="ocat-label">@T["Provider"]</span>
    <div class="ocat-end">
        <span>@Model.ProviderDisplayName</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Name">
    <label asp-for="Name" class="ocat-label ocat-label-required">@T["Connection Name"]</label>
    <div class="ocat-end">
        <input asp-for="Name" class="form-control" autofocus="autofocus" />
        <span asp-validation-for="Name"></span>
        <span class="hint">@T["A friendly name to identify this carrier account (e.g. 'Main production account')."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="IsEnabled" class="form-check-input" type="checkbox" />
            <label asp-for="IsEnabled" class="form-check-label">@T["Enabled"]</label>
        </div>
        <span class="hint">@T["Disable to temporarily stop this connection from being used for rate quotes or shipment creation."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="IsTestMode" class="form-check-input" type="checkbox" />
            <label asp-for="IsTestMode" class="form-check-label">@T["Test / Sandbox Mode"]</label>
        </div>
        <span class="hint">@T["Use the carrier's sandbox environment. Rates and labels will not be real."]</span>
    </div>
</div>
