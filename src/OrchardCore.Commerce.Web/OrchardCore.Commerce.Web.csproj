<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CopyRefAssembliesToPublishDirectory>true</CopyRefAssembliesToPublishDirectory>
    <IsPackable>false</IsPackable>
    <OrchardCoreVersion>3.0.1</OrchardCoreVersion>
    <!-- "Project" references the Kytrixlabs.Commerce.Shipping.* modules from the sibling Kytrixlabs.Commerce repository
         (see KytrixlabsCommerceRoot in Directory.Build.props), "Package" uses their NuGet packages. Defaults to
         "Project" when that repository exists. Override with e.g. -p:KytrixlabsCommerceReferenceMode=Package. -->
    <KytrixlabsCommerceReferenceMode Condition="'$(KytrixlabsCommerceReferenceMode)' == '' AND Exists('$(KytrixlabsCommerceRoot)')">Project</KytrixlabsCommerceReferenceMode>
    <KytrixlabsCommerceReferenceMode Condition="'$(KytrixlabsCommerceReferenceMode)' == ''">Package</KytrixlabsCommerceReferenceMode>
  </PropertyGroup>

  <!-- Currently we don't have any ps1/psm1/psd1 files in the repo, so this is commented out. Add the ProjectReference
       below when this changes.
  <ItemGroup>
    <PackageReference Include="Lombiq.Analyzers.PowerShell" Version="1.0.1-occ-15.0" />
  </ItemGroup> -->

  <ItemGroup>
    <PackageReference Include="GraphQL.MicrosoftDI" />
    <PackageReference Include="GraphQL.SystemTextJson" />
    <PackageReference Include="Lombiq.Tests.UI.AppExtensions" />
    <PackageReference Include="Lombiq.Tests.UI.Shortcuts" />
    <PackageReference Include="Microsoft.Identity.Web"/>
    <PackageReference Include="OrchardCore.Commerce.Translations" />

    <!-- The Orchard Core packages must override the version to target the latest patch version in this project. See the
         Directory.Packages.props file for more details. -->
    <PackageReference Include="OrchardCore.Application.Cms.Targets" VersionOverride="$(OrchardCoreVersion)" />
    <PackageReference Include="OrchardCore.Logging.NLog" VersionOverride="$(OrchardCoreVersion)" />
    <PackageReference Include="Lombiq.HelpfulLibraries.AspNetCore" />
    <PackageReference Include="Lombiq.HelpfulLibraries.Common" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\test\OrchardCore.Commerce.Tests.UI.Shortcuts\OrchardCore.Commerce.Tests.UI.Shortcuts.csproj" />
    <ProjectReference Include="..\Modules\OrchardCore.Commerce.Payment.Stripe\OrchardCore.Commerce.Payment.Stripe.csproj" />
    <ProjectReference Include="..\Modules\OrchardCore.Commerce\OrchardCore.Commerce.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(KytrixlabsCommerceReferenceMode)' == 'Project'">
    <ProjectReference Include="$(KytrixlabsCommerceRoot)src\Modules\Kytrixlabs.Commerce.Order.Management\Kytrixlabs.Commerce.Order.Management.csproj" />
    <ProjectReference Include="$(KytrixlabsCommerceRoot)src\Modules\Kytrixlabs.Commerce.Payment.Przelewy24\Kytrixlabs.Commerce.Payment.Przelewy24.csproj" />
    <ProjectReference Include="$(KytrixlabsCommerceRoot)src\Modules\Kytrixlabs.Commerce.Payment.TPay\Kytrixlabs.Commerce.Payment.TPay.csproj" />
    <ProjectReference Include="$(KytrixlabsCommerceRoot)src\Modules\Kytrixlabs.Commerce.Shipping.Dhl\Kytrixlabs.Commerce.Shipping.Dhl.csproj" />
    <ProjectReference Include="$(KytrixlabsCommerceRoot)src\Modules\Kytrixlabs.Commerce.Shipping.Dpd\Kytrixlabs.Commerce.Shipping.Dpd.csproj" />
    <ProjectReference Include="$(KytrixlabsCommerceRoot)src\Modules\Kytrixlabs.Commerce.Shipping.InPost\Kytrixlabs.Commerce.Shipping.InPost.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(KytrixlabsCommerceReferenceMode)' != 'Project'">
    <PackageReference Include="Kytrixlabs.Commerce.Order.Management" />
    <PackageReference Include="Kytrixlabs.Commerce.Payment.Przelewy24" />
    <PackageReference Include="Kytrixlabs.Commerce.Payment.TPay" />
    <PackageReference Include="Kytrixlabs.Commerce.Shipping.Dhl" />
    <PackageReference Include="Kytrixlabs.Commerce.Shipping.Dpd" />
    <PackageReference Include="Kytrixlabs.Commerce.Shipping.InPost" />
  </ItemGroup>

</Project>
